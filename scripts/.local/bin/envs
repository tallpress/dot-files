#!/bin/bash

# Colors
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

echo -e "${CYAN}AWS_PROFILE:${NC}  ${GREEN}${AWS_PROFILE:-${YELLOW}<not set>${NC}}"
echo -e "${CYAN}KUBECONFIG:${NC}   ${GREEN}${KUBECONFIG:-${YELLOW}<not set>${NC}}"
echo -e "${CYAN}Kube context:${NC} ${GREEN}$(kubectl config current-context 2>/dev/null || echo -e "${YELLOW}<not set>")"
