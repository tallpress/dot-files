#!/bin/bash
# List open todos (- [ ]) across the Obsidian vault and jump to one in nvim.

vault="$HOME/notes"

selection=$(rg --no-heading --line-number --color=never \
    --glob '*.md' '^\s*- \[ \]' "$vault" \
    | sed "s|^$vault/||" \
    | fzf --ansi --delimiter=':' \
        --with-nth='1,3..' \
        --preview "bat --color=always --style=numbers --highlight-line {2} $vault/{1}" \
        --preview-window='right,60%,+{2}-/2' \
        --prompt='todo> ')

[ -z "$selection" ] && exit 0

file=$(echo "$selection" | cut -d: -f1)
line=$(echo "$selection" | cut -d: -f2)

nvim "+$line" "$vault/$file"
